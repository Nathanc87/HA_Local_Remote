#!/usr/bin/with-contenv bash
set -e

mkdir -p /share/ha_local_remote/chromium
export HOME=/share/ha_local_remote
export DISPLAY=:0

# Start a virtual desktop for Chromium.
Xvfb :0 -screen 0 1440x900x24 -ac +extension RANDR &
sleep 1
openbox-session &

# Keep a persistent browser profile in the add-on's shared storage.
chromium-browser \
  --no-sandbox \
  --disable-dev-shm-usage \
  --user-data-dir=/share/ha_local_remote/chromium \
  --no-first-run \
  --no-default-browser-check \
  --start-maximized \
  about:blank &

# VNC listens on loopback only. The websockify/noVNC endpoint is exposed
# on the add-on Ingress port and must not be published directly to the WAN.
x11vnc -display :0 -forever -shared -nopw -localhost -rfbport 5900 &
exec websockify --web=/usr/share/novnc/ 6080 localhost:5900
